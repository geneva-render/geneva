{
  "geneva": "0.3",
  "output": {
    "width": 1280,
    "height": 720,
    "fps": 30
  },
  "assets": {
    "iss": {
      "src": "iss.mp4"
    },
    "words": {
      "src": "words.json"
    }
  },
  "layers": [
    {
      "id": "footage",
      "clips": [
        {
          "source": {
            "kind": "video",
            "asset": "iss"
          }
        }
      ]
    },
    {
      "id": "captions",
      "clips": [
        {
          "source": {
            "kind": "captions",
            "asset": "words",
            "style": {
              "font": "700 44px Liberation Sans",
              "color": "white",
              "highlight": {
                "color": "#ffd233"
              },
              "outline": "3px #000000cc",
              "max_width": "80%"
            }
          }
        }
      ]
    }
  ]
}
