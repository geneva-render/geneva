          "color": "white",
          "highlight": { "color": "#ffd233" },
          "outline": "3px #000000cc",
          "max_width": "80%"
        },
        "start": "1s", "duration": "3.4s",
        "transform": { "position": "50% 80%" } } ] },

    { "id": "translation", "clips": [ {
        "source": {
          "kind": "text",
          "text": "التقاط مركبة دراجون بذراع المحطة",
          "font": "400 28px Liberation Sans",
