{
  "geneva": "0.3",
  "output": {
    "width": 1080, "height": 1920, "fps": 30,
    "encode": {
      "video": { "codec": "h264", "crf": 23, "keyframe_interval": 2 },
      "audio": { "codec": "aac", "bitrate_kbps": 128 },
      "fast_start": true
    }
  },

  "assets": { "iss": { "src": "iss.mp4" } },

  "layers": [
    { "id": "backdrop", "clips": [ {
        "source": { "kind": "video", "asset": "iss", "audio": false },
        "fit": "cover",
        "effects": [ { "kind": "blur", "radius": 45 } ] } ] },

    { "id": "picture", "clips": [ {
        "source": { "kind": "video", "asset": "iss" },
        "fit": "contain" } ] },

    { "id": "captions", "clips": [ {
        "source": {
          "kind": "text",
          "words": [ ["Every", 0], ["word", "0.4s"], ["lands", "0.8s"], ["on", "1.3s"],
                     ["its", "1.5s"], ["own", "1.8s"], ["beat", "2.2s", "3s"] ],
          "font": "700 72px/1.25 Liberation Sans",
          "color": "white",
          "highlight": { "color": "#ffd233" },
          "outline": "4px #000000cc",
          "max_width": "80%",
          "align": "center"
        },
        "duration": "3s",
        "transform": { "position": "50% 72%" } } ] }
  ]
}
