{
  "geneva": "1.1",
  "output": { "width": 640, "height": 360, "fps": 30, "duration": "3s", "background": "#101418" },
  "layers": [
    {
      "id": "card",
      "clips": [
        {
          "id": "panel",
          "source": { "kind": "shape", "shape": "rect", "width": "60%", "height": 200, "fill": "#2b3a55", "radius": 24 },
          "transform": {
            "position": "center",
            "scale": { "keyframes": [ [0, 0.8, "ease-out"], ["0.5s", 1] ] }
          },
          "opacity": { "keyframes": [ [0, 0], ["0.5s", 1] ] }
        }
      ]
    },
    {
      "id": "dot",
      "clips": [
        {
          "id": "orbit",
          "source": { "kind": "shape", "shape": "ellipse", "width": 48, "height": 48, "fill": "#ffb347", "stroke": { "color": "#ffffff", "width": 3 } },
          "start": "0.5s",
          "transform": {
            "position": { "keyframes": [
              [0, "25% 50%", "ease-in-out"],
              ["1s", "75% 50%", { "spring": { "damping": 12 } }],
              ["2s", "50% 25%"]
            ] },
            "rotation": { "keyframes": [ [0, 0], ["2.5s", 360] ] }
          }
        }
      ]
    }
  ]
}
