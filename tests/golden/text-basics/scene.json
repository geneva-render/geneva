{
  "geneva": "1.0",
  "output": { "width": 480, "height": 270, "fps": 30, "duration": "2s", "background": "#1d2230" },
  "assets": {
    "sans": { "src": "fonts/LiberationSans-Regular.ttf" },
    "sans-bold": { "src": "fonts/LiberationSans-Bold.ttf" }
  },
  "layers": [
    { "id": "title", "clips": [ { "source": { "kind": "text", "text": "Rendered text", "font": "sans-bold", "size": 44, "color": "#ffffff",
        "outline": { "color": "#000000", "width": 2 }, "shadow": { "x": 3, "y": 3, "blur": 4 } },
        "transform": { "position": { "x": "50%", "y": "28%" } } } ] },
    { "id": "caption", "clips": [ { "source": { "kind": "text",
        "words": [ { "text": "One", "start": 0, "end": "0.5s" }, { "text": "word", "start": "0.5s", "end": "1s" }, { "text": "at", "start": "1s", "end": "1.3s" }, { "text": "a", "start": "1.3s", "end": "1.5s" }, { "text": "time", "start": "1.5s", "end": "2s" } ],
        "font": "sans", "size": 30, "color": "#e8e8e8", "highlight": { "color": "#ffb347", "font": "sans-bold" },
        "background": "#00000099", "padding": 12, "radius": 10 },
        "transform": { "position": { "x": "50%", "y": "80%" } } } ] },
    { "id": "paragraph", "clips": [ { "source": { "kind": "text", "text": "A left-aligned paragraph that wraps onto several lines inside a fixed width box.",
        "font": "sans", "size": 18, "align": "left", "max_width": 220, "line_height": 1.3, "color": "#c0c8d0" },
        "transform": { "anchor": { "x": "0%", "y": "0%" }, "position": { "x": 20, "y": 100 } } } ] }
  ]
}
