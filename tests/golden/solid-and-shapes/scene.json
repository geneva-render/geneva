{
  "geneva": "0.1",
  "output": { "width": 640, "height": 360, "fps": 30, "duration": "3s", "background": "#101418" },
  "layers": [
    {
      "id": "card",
      "clips": [
        {
          "id": "panel",
          "source": { "kind": "shape", "shape": "rect", "width": "60%", "height": 200, "fill": "#2b3a55", "radius": 24 },
          "transform": {
            "position": { "x": "50%", "y": "50%" },
            "scale": { "keyframes": [ { "t": 0, "v": 0.8, "ease": "ease-out" }, { "t": "0.5s", "v": 1 } ] }
          },
          "opacity": { "keyframes": [ { "t": 0, "v": 0 }, { "t": "0.5s", "v": 1 } ] }
        }
      ]
    },
    {
      "id": "dot",
      "clips": [
        {
          "id": "orbit",
          "source": { "kind": "shape", "shape": "ellipse", "width": 48, "height": 48, "fill": "#ffb347", "stroke": { "color": "#ffffff", "width": 3 } },
          "start": "0.5s",
          "transform": {
            "position": { "keyframes": [
              { "t": 0, "v": { "x": "25%", "y": "50%" }, "ease": "ease-in-out" },
              { "t": "1s", "v": { "x": "75%", "y": "50%" }, "ease": { "spring": { "damping": 12 } } },
              { "t": "2s", "v": { "x": "50%", "y": "25%" } }
            ] },
            "rotation": { "keyframes": [ { "t": 0, "v": 0 }, { "t": "2.5s", "v": 360 } ] }
          }
        }
      ]
    }
  ]
}
