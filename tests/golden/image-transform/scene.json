{
  "geneva": "1.0",
  "output": { "width": 256, "height": 144, "fps": 24, "duration": "2s", "background": "#202020" },
  "assets": { "checker": { "src": "image-transform/checker.png" } },
  "layers": [
    { "id": "aligned", "clips": [ { "source": { "kind": "image", "asset": "checker" },
        "transform": { "anchor": { "x": 0, "y": 0 }, "position": { "x": 8, "y": 8 } } } ] },
    { "id": "contained", "clips": [ { "source": { "kind": "image", "asset": "checker" }, "fit": "contain",
        "transform": { "position": { "x": "50%", "y": "50%" } }, "opacity": 0.6 } ] },
    { "id": "spinning", "clips": [ { "source": { "kind": "image", "asset": "checker" },
        "transform": { "position": { "x": 200, "y": 100 }, "scale": 1.5,
          "rotation": { "keyframes": [ { "t": 0, "v": 0, "ease": "ease-in-out" }, { "t": "2s", "v": 180 } ] } } } ] }
  ]
}
