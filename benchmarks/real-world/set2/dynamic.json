      "asset": "film"
     }
    }
   ]
  },
  {
   "id": "captions",
   "clips": [
    {
     "source": {
      "kind": "captions",
      "asset": "words",
      "margin": "10%",
      "style": {
       "font": "800 54px/1.2 Liberation Sans",
       "color": "white",
       "outline": "5px #000000",
       "highlight": {
        "color": "#22d3ee"
       },
       "max_width": "70%"
      }
     }
    }
   ]
  },
  {
   "id": "cards",
   "clips": [
    {
     "source": {
      "kind": "html",
      "asset": "nc1"
     },
     "start": "3s",
     "duration": "4s"
    },
    {
     "source": {
      "kind": "html",
      "asset": "nc2"
     },
     "start": "30s",
     "duration": "4s"
    },
    {
     "source": {
      "kind": "html",
      "asset": "nc3"
     },
     "start": "60s",
     "duration": "4s"
    }
   ]
  },
  {
   "id": "badge",
   "clips": [
    {
     "source": {
      "kind": "html",
      "asset": "badge"
     }
    }
   ]
  }
 ]
