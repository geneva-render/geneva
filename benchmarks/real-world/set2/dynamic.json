{
 "geneva": "1.0",
 "output": {
  "width": 1920,
  "height": 800,
  "fps": 24,
  "duration": "90s"
 },
 "assets": {
  "film": {
   "src": "media/dynamic-film.mp4"
  },
  "words": {
   "src": "media/dynamic-words.json"
  },
  "badge": {
   "src": "job/badge.html"
  },
  "nc1": {
   "src": "job/namecard-1.html"
  },
  "nc2": {
   "src": "job/namecard-2.html"
  },
  "nc3": {
   "src": "job/namecard-3.html"
  }
 },
 "layers": [
